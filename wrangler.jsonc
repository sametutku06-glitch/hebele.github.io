{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sinav-cam-portali",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-24",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "sinav-cam-portali", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sinav-cam-portali-files" }]
}
